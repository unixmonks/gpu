             off = kwargs.pop("enable_thinking", True) is False
@@ -1261,13 +1292,131 @@ class MinimaxRewriter:
         return {n: v for n, v in items}
 
 
+BEAM_START, BEAM_END, BEAM_MSG, BEAM_CHAN = "<|start|>", "<|end|>", "<|message|>", "<|channel|>"
