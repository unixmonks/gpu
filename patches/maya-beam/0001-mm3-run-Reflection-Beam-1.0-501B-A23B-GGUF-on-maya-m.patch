diff --git a/tools/mm3/beam_chat_template.jinja b/tools/mm3/beam_chat_template.jinja
new file mode 100644
index 0000000..6f7d854
--- /dev/null
+++ b/tools/mm3/beam_chat_template.jinja
@@ -0,0 +1,469 @@
+{#-
+  harmony_xml: Harmony wire format with XML tool-call bodies.
+
+  Channels are `analysis` and `final`; there is no commentary channel. Tools
+  are declared as flat TypeScript under `# Tools` and called with
+  `<|constrain|>xml` and `rfl:parameter` bodies.
+
+  Kwargs:
+  - model_identity: defaults to "You are Beam, an AI assistant trained by
+    Reflection."
+  - reasoning_effort: emits `Reasoning effort: N` after the identity line;
+    defaults to 512 (`max`) when unset or null. Accepts an int, or the labels
+    `minimal`/`low`/`medium`/`high`/`xhigh`/`max` mapped to
+    8/32/64/128/256/512. Other strings raise. `minimal` is 8, the smallest
+    effort training sampled: a smaller budget is not respected.
+  - builtin_tools: names from `tools=` to render in the system `# Tools` block,
+    with their own definitions. Only name `search` and `browse`, and only with
+    the definitions Beam was trained with. Every other tool, including a
+    `search` or `browse` with a different definition, belongs in the developer
+    block, where `tools=` renders it by default.
+    Exception: a `bash` tool whose only parameter is an unconstrained `command`
+    string is always declared in the system block with the trained definition,
+    without this kwarg; its own descriptions are not rendered. A `bash` with
+    any other call shape follows the rule above.
+  - allow_missing_thinking: defaults to true. When false, a generation prompt
+    raises when any assistant turn has empty or no reasoning, since dropping it
+    degrades the model's output. Setting it to false is highly recommended for
+    serving.
+
+  OpenAI roles "system" and "developer" are equivalent and map to the developer
+  `# Instructions` block. Consecutive ones at the start of `messages` join into
+  that one block, a blank line apart; empty content is omitted. A system or
+  developer message after the first message of another role is not rendered.
+  The Reflection system block is injected before the developer block.
+
+  Tool wire:
+  - Calls: `to={name}` + analysis + `<|constrain|>xml` + rfl: body
+  - Results: `{recipient} to=assistant` on analysis
+  - Parallel calls: `<|end|>` between calls, `<|call|>` on the last
+  - `function.arguments` must be a dict (parse JSON strings before apply)
+-#}
+
+{%- macro ts_type_name(type_val) -%}
+    {%- if type_val == "integer" -%}
+        {{- "number" -}}
+    {%- elif type_val in ["string", "number", "boolean"] -%}
+        {{- type_val -}}
+    {%- else -%}
+        {{- "any" -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{#- Property defaults render enum strings bare. Generic `oneOf` variants pass
+   false because the reference renderer quotes them in that path. #}
+{%- macro render_default(schema, bare_enum_string=true) -%}
+    {%- set is_enum = schema.get("enum") is sequence and schema.get("enum") is not string and schema.get("enum") -%}
+    {%- if schema.default is string and (not is_enum or not bare_enum_string) -%}
+        {{- '"' + schema.default + '"' -}}
+    {%- elif schema.default is string -%}
+        {{- schema.default -}}
+    {%- else -%}
+        {{- schema.default | tojson(separators=(",", ":")) -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{#- The reference renderer checks the complete rendered text for `null`, so
+   this intentionally does the same rather than inspecting schema members. #}
+{%- macro render_nullable_type(schema, indent) -%}
+    {%- set rendered = json_schema_to_typescript(schema, indent) -%}
+    {{- rendered -}}
+    {%- if schema is mapping and schema.get("nullable") and "null" not in rendered -%}
+        {{- " | null" -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{#- Render a JSON-schema node as a TypeScript type.
+
+   `indent` is the leading spaces for properties inside an object; nested
+   objects bump it by 4. Use `schema["items"]` (not `schema.items`), since
+   attribute access would hit dict.items. #}
+{%- macro json_schema_to_typescript(schema, indent=0) -%}
+    {%- if schema is mapping and schema.get("oneOf") is sequence and schema.get("oneOf") is not string -%}
+        {%- for variant in schema.oneOf -%}
+            {{- "\n" + (" " * indent) + " | " -}}
+            {{- render_nullable_type(variant, indent + 3) -}}
+            {%- if variant is mapping and variant.get("description") is string -%}
+                {{- " // " + variant.description -}}
+                {%- if "default" in variant -%}
+                    {{- " default: " + render_default(variant, false) -}}
+                {%- endif -%}
+            {%- elif variant is mapping and "default" in variant -%}
+                {{- " // default: " + render_default(variant, false) -}}
+            {%- endif -%}
+        {%- endfor -%}
+    {#- Only a string enum becomes a literal union. An integer or untyped enum
+       falls through to its plain type, or to `any` when it has none. #}
+    {%- elif schema is mapping and schema.get("enum") is sequence and schema.get("enum") is not string and schema.get("enum") and schema.get("type") == "string" -%}
+        {%- set rendered_enum = namespace(any=false) -%}
+        {%- for val in schema.enum -%}
+            {%- if val is string -%}
+                {%- if rendered_enum.any %} | {% endif -%}
+                {{- val | tojson -}}
+                {%- set rendered_enum.any = true -%}
+            {%- endif -%}
+        {%- endfor -%}
+        {%- if not rendered_enum.any %}string{%- endif -%}
+    {%- elif schema is mapping and schema.get("type") == "object" -%}
+        {%- if schema.get("description") is string -%}
+            {{- (" " * indent) + "// " + schema.description + "\n" -}}
+        {%- endif -%}
+        {{- "{\n" -}}
+        {%- set required = schema.required if schema.get("required") else [] -%}
+        {%- if schema.get("properties") -%}
+            {#- Properties render in insertion order, so a schema controls the
+               order its parameters appear in. #}
+            {%- for prop_name, prop_spec in schema.properties.items() -%}
+                {%- if prop_spec is mapping and prop_spec.get("title") is string -%}
+                    {{- (" " * indent) + "// " + prop_spec.title + "\n" -}}
+                    {{- (" " * indent) + "//\n" -}}
+                {%- endif -%}
+                {%- if prop_spec is mapping and "oneOf" not in prop_spec and prop_spec.get("description") is string -%}
+                    {{- (" " * indent) + "// " + prop_spec.description + "\n" -}}
+                {%- endif -%}
+                {%- if prop_spec is mapping and prop_spec.get("examples") is sequence and prop_spec.get("examples") is not string and prop_spec.get("examples") -%}
+                    {{- (" " * indent) + "// Examples:\n" -}}
+                    {%- for example in prop_spec.examples -%}
+                        {%- if example is string -%}
+                            {{- (" " * indent) + '// - "' + example + '"\n' -}}
+                        {%- endif -%}
+                    {%- endfor -%}
+                {%- endif -%}
+                {%- if prop_spec is mapping and prop_spec.get("oneOf") is sequence and prop_spec.get("oneOf") is not string -%}
+                    {%- set property_description = prop_spec.get("description") if prop_spec.get("description") is string else none -%}
+                    {%- set first_variant = prop_spec.oneOf[0] if prop_spec.oneOf else {} -%}
+                    {%- set first_description = first_variant.get("description") if first_variant is mapping and first_variant.get("description") is string else none -%}
+                    {%- set render_property_description = property_description and property_description != first_description -%}
+                    {%- if render_property_description -%}
+                        {{- (" " * indent) + "// " + property_description + "\n" -}}
+                    {%- endif -%}
+                    {%- if "default" in prop_spec -%}
+                        {{- (" " * indent) + "// default: " + render_default(prop_spec) + "\n" -}}
+                    {%- endif -%}
+                    {{- (" " * indent) + prop_name -}}
+                    {%- if prop_name not in required -%}?{%- endif -%}
+                    {{- ":\n" -}}
+                    {%- for variant in prop_spec.oneOf -%}
+                        {{- (" " * indent) + " | " -}}
+                        {{- render_nullable_type(variant, indent + 3) -}}
+                        {%- set render_variant_description = variant is mapping and variant.get("description") is string and variant.description != property_description and not (loop.first and render_property_description) -%}
+                        {%- if render_variant_description -%}
+                            {{- " // " + variant.description -}}
+                            {%- if "default" in variant -%}
+                                {{- " default: " + render_default(variant) -}}
+                            {%- endif -%}
+                        {%- elif variant is mapping and "default" in variant -%}
+                            {{- " // default: " + render_default(variant) -}}
+                        {%- endif -%}
+                        {{- "\n" -}}
+                    {%- endfor -%}
+                    {{- (" " * indent) + ",\n" -}}
+                {%- else -%}
+                    {{- (" " * indent) + prop_name -}}
+                    {%- if prop_name not in required -%}?{%- endif -%}
+                    {{- ": " -}}
+                    {{- render_nullable_type(prop_spec, indent + 4) -}}
+                    {{- "," -}}
+                    {%- if prop_spec is mapping and "default" in prop_spec -%}
+                        {{- " // default: " + render_default(prop_spec) -}}
+                    {%- endif -%}
+                    {{- "\n" -}}
+                {%- endif -%}
+            {%- endfor -%}
+        {%- endif -%}
+        {{- (" " * indent) + "}" -}}
+    {%- elif schema is mapping and schema.get("type") == "array" -%}
+        {%- if schema.get("items") -%}
+            {{- json_schema_to_typescript(schema["items"], indent) + "[]" -}}
+        {%- else -%}
+            {{- "Array<any>" -}}
+        {%- endif -%}
+    {%- elif schema is mapping and schema.get("type") is string -%}
+        {{- ts_type_name(schema.type) -}}
+    {%- elif schema is mapping and schema.get("type") is sequence -%}
+        {%- set rendered_types = namespace(any=false) -%}
+        {%- for ty in schema.type -%}
+            {%- if ty is string -%}
+                {%- if rendered_types.any %} | {% endif -%}
+                {%- if ty == "integer" %}number{%- else %}{{ ty }}{%- endif -%}
+                {%- set rendered_types.any = true -%}
+            {%- endif -%}
+        {%- endfor -%}
+        {%- if not rendered_types.any %}any{%- endif -%}
+    {%- else -%}
+        {{- "any" -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{#- String-schema tools declare as `## name`; every other tool declares as
+   `type name = (_: {...}) => any;`. Call sites emit XML either way. #}
+{%- macro render_tool_declaration(tool) -%}
+    {%- set tool = tool.function if tool.function is defined else tool -%}
+    {%- if tool.parameters is mapping and tool.parameters.get("type") == "string" and (not tool.parameters.get("properties")) -%}
+        {{- "## " + tool.name + "\n\n" -}}
+        {{- tool.description or "" -}}
+    {%- else -%}
+        {%- if tool.description -%}
+            {%- for line in tool.description.split("\n") -%}
+                {{- "// " + line + "\n" -}}
+            {%- endfor -%}
+        {%- endif -%}
+        {#- A tool with no parameters keeps the `(_: ...)` form and renders
+           `(_: any)`. #}
+        {{- "type " + tool.name + " = (_: " + json_schema_to_typescript(tool.parameters) + ") => any;" -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{%- macro render_tools_section(tools) -%}
+    {{- "# Tools\n\n" -}}
+    {%- for tool in tools -%}
+        {{- render_tool_declaration(tool) -}}
+        {%- if not loop.last -%}
+            {{- "\n\n" -}}
+        {%- endif -%}
+    {%- endfor -%}
+{%- endmacro -%}
+
+{#- String values go out as-is; non-strings are JSON-encoded in their given
+   order, at every depth. Jinja's `tojson` sorts keys by default, so mappings
+   and sequences recurse through this macro instead of being handed to it. #}
+{%- macro render_json_value(value) -%}
+    {%- if value is mapping -%}
+        {{- "{" -}}
+        {%- for k, v in value.items() -%}
+            {{- k | tojson }}: {{ render_json_value(v) -}}
+            {%- if not loop.last %}, {% endif -%}
+        {%- endfor -%}
+        {{- "}" -}}
+    {%- elif value is sequence and value is not string -%}
+        {{- "[" -}}
+        {%- for item in value -%}
+            {{- render_json_value(item) -}}
+            {%- if not loop.last %}, {% endif -%}
+        {%- endfor -%}
+        {{- "]" -}}
+    {%- else -%}
+        {{- value | tojson -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{%- macro render_parameter_value(value) -%}
+    {%- if value is string -%}
+        {{- value -}}
+    {%- else -%}
+        {{- render_json_value(value) -}}
+    {%- endif -%}
+{%- endmacro -%}
+
+{%- macro render_tool_call_body(tool_call) -%}
+    {%- set fn = tool_call.function if tool_call.function is defined else tool_call -%}
+    {%- set args = fn.arguments if fn.arguments is defined else tool_call.arguments -%}
+    {%- if args is mapping -%}
+        {%- for param_name in args -%}
+            {%- set value_text = render_parameter_value(args[param_name]) -%}
+            {%- if "</rfl:parameter>" in value_text -%}
+                {{- raise_exception("Tool-call parameter '" + (param_name | string) + "' contains the reserved delimiter </rfl:parameter>") }}
+            {%- endif -%}
+            {%- if not loop.first %}{{- "\n" }}{%- endif -%}
+            {{- '<rfl:parameter name="' + param_name + '">\n' -}}
+            {{- value_text -}}
+            {{- '\n</rfl:parameter>' -}}
+        {%- endfor -%}
+    {%- elif args is defined and args is not none -%}
+        {{- raise_exception("function.arguments must be a dict; parse JSON strings before apply_chat_template") }}
+    {%- endif -%}
+{%- endmacro -%}
+
+{%- macro build_system_message(builtin_tool_definitions) -%}
+    {%- if model_identity is not defined %}
+        {%- set model_identity = "You are Beam, an AI assistant trained by Reflection." %}
+    {%- endif %}
+    {{- model_identity -}}
+    {#- Served default: effort 512 (`max`) when the kwarg is unset or null. #}
+    {%- if reasoning_effort is not defined or reasoning_effort is none %}
+        {%- set reasoning_effort = 512 %}
+    {%- endif %}
+    {%- if reasoning_effort is string %}
+        {%- if reasoning_effort == "minimal" %}
+            {%- set reasoning_effort = 8 %}
+        {%- elif reasoning_effort == "low" %}
+            {%- set reasoning_effort = 32 %}
+        {%- elif reasoning_effort == "medium" %}
+            {%- set reasoning_effort = 64 %}
+        {%- elif reasoning_effort == "high" %}
+            {%- set reasoning_effort = 128 %}
+        {%- elif reasoning_effort == "xhigh" %}
+            {%- set reasoning_effort = 256 %}
+        {%- elif reasoning_effort == "max" %}
+            {%- set reasoning_effort = 512 %}
+        {%- else %}
+            {{- raise_exception("reasoning_effort must be an int or one of: minimal, low, medium, high, xhigh, max") }}
+        {%- endif %}
+    {%- endif %}
+    {{- "\n\nReasoning effort: " + (reasoning_effort | string) }}
+    {%- if builtin_tool_definitions -%}
+        {{- "\n\n" -}}
+        {{- render_tools_section(builtin_tool_definitions) -}}
+    {%- endif -%}
+    {{- "\n\n# Valid channels: analysis, final. Channel must be included for every message." -}}
+{%- endmacro -%}
+
+{%- if not messages %}{{ raise_exception("messages cannot be empty") }}{%- endif %}
+
+{#- `tools=` remains the serving engine's complete tool registry. The names in
+   `builtin_tools` only select which definitions move into the system block. #}
+{%- set builtin_tool_names = builtin_tools | default([], true) -%}
+{#- Training declares `bash` in the system block with this definition, so a
+   `bash` whose only parameter is an unconstrained `command` string is declared
+   with it. Only descriptions and `additionalProperties` may differ, since they
+   leave the accepted calls the same; any schema key that constrains the call
+   keeps the supplied definition in the developer block. An omitted `required`
+   is declared as required: every call the trained declaration invites is one
+   the supplied schema accepts. #}
+{%- set trained_bash_tool = {
+    "name": "bash",
+    "description": "Execute a bash command. The output contains the command's stdout and stderr.\nCommands time out after 10 minutes. You can set a shorter timeout within the bash command.",
+    "parameters": {
+        "type": "object",
+        "properties": {"command": {"type": "string", "description": "The command to execute"}},
+        "required": ["command"],
+    },
+} -%}
+{%- set tool_groups = namespace(builtin=[], regular=[]) -%}
+{%- for tool in tools | default([], true) -%}
+    {%- set tool_definition = tool.function if tool.function is defined else tool -%}
+    {%- set tool_name = tool_definition.name -%}
+    {%- set tool_parameters = tool_definition.parameters if tool_definition.parameters is mapping else {} -%}
+    {%- set tool_properties = tool_parameters.properties if tool_parameters.properties is mapping else {} -%}
+    {%- set bash_shape = namespace(plain=true) -%}
+    {%- for key in tool_parameters -%}
+        {%- if key not in ["type", "properties", "required", "additionalProperties", "description"] -%}
+            {%- set bash_shape.plain = false -%}
+        {%- endif -%}
+    {%- endfor -%}
+    {%- set command_schema = tool_properties.command if tool_properties.command is mapping else {} -%}
+    {%- for key in command_schema -%}
+        {%- if key not in ["type", "description"] -%}
+            {%- set bash_shape.plain = false -%}
+        {%- endif -%}
+    {%- endfor -%}
+    {%- set is_trained_bash = tool_name == "bash"
+        and bash_shape.plain
+        and tool_parameters.get("type") == "object"
+        and (tool_properties | list) == ["command"]
+        and command_schema.get("type") == "string"
+        and tool_parameters.get("required", ["command"]) == ["command"] -%}
+    {%- if is_trained_bash -%}
+        {%- set tool_groups.builtin = tool_groups.builtin + [trained_bash_tool] -%}
+    {%- elif tool_name in builtin_tool_names -%}
+        {%- set tool_groups.builtin = tool_groups.builtin + [tool] -%}
+    {%- else -%}
+        {%- set tool_groups.regular = tool_groups.regular + [tool] -%}
+    {%- endif -%}
+{%- endfor -%}
+
+{{- "<|start|>system<|message|>" }}
+{{- build_system_message(tool_groups.builtin) }}
+{{- "<|end|>" }}
+
+{#- The leading run of system/developer messages joins, a blank line apart,
+   into the one `# Instructions` block. Empty content counts as absent, so a
+   run with no content emits no `# Instructions`. #}
+{%- set leading_instructions = namespace(count=0, parts=[]) %}
+{%- for message in messages %}
+    {%- if loop.index0 == leading_instructions.count and message.role in ["system", "developer"] %}
+        {%- set leading_instructions.count = leading_instructions.count + 1 %}
+        {%- if message.content %}
+            {%- set leading_instructions.parts = leading_instructions.parts + [message.content] %}
+        {%- endif %}
+    {%- endif %}
+{%- endfor %}
+{%- set developer_message = leading_instructions.parts | join("\n\n") %}
+{%- set loop_messages = messages[leading_instructions.count:] %}
+
+{%- if add_generation_prompt and allow_missing_thinking is defined and allow_missing_thinking == false %}
+    {%- for message in loop_messages %}
+        {%- if message.role == 'assistant' and not (message.thinking or message.reasoning_content or message.reasoning) %}
+            {{- raise_exception("The assistant turn at messages[" + ((loop.index0 + leading_instructions.count) | string) + "] is missing its reasoning. Dropping reasoning from earlier turns degrades this model's output. Send it back in 'reasoning_content', or set allow_missing_thinking=true to skip this check.") }}
+        {%- endif %}
+    {%- endfor %}
+{%- endif %}
+
+{%- set has_tools = tool_groups.regular %}
+
+{%- if developer_message or has_tools %}
+    {{- "<|start|>developer<|message|>" }}
+    {%- if developer_message %}
+        {{- "# Instructions\n\n" }}
+        {{- developer_message }}
+        {%- if has_tools %}
+            {{- "\n\n" }}
+        {%- endif %}
+    {%- endif %}
+    {%- if has_tools %}
+        {{- render_tools_section(tool_groups.regular) }}
+    {%- endif %}
+    {{- "<|end|>" }}
+{%- endif %}
+
+{%- set tool_call_registry = namespace(entries=[]) %}
+
+{%- for message in loop_messages -%}
+    {%- if message.role == 'assistant' -%}
+        {%- if message.content %}
+            {%- if "<|channel|>analysis<|message|>" in message.content or "<|channel|>final<|message|>" in message.content %}
+                {{- raise_exception("Pass plain text in API fields, not Harmony wire tags. Use 'thinking' for analysis and 'content' for final.") }}
+            {%- endif %}
+        {%- endif %}
+        {%- set thinking_text = message.thinking or message.reasoning_content or message.reasoning %}
+        {%- if thinking_text %}
+            {%- if "<|channel|>analysis<|message|>" in thinking_text or "<|channel|>final<|message|>" in thinking_text %}
+                {{- raise_exception("Pass plain text in 'thinking'/'reasoning_content'/'reasoning' without Harmony wire tags.") }}
+            {%- endif %}
+        {%- endif %}
+        {{- "<|start|>assistant" }}
+        {%- generation %}
+        {{- "<|channel|>analysis<|message|>" + (thinking_text or "") + "<|end|>" }}
+        {%- if message.tool_calls %}
+            {%- for tool_call in message.tool_calls %}
+                {%- set fn = tool_call.function if tool_call.function is defined else tool_call %}
+                {%- set tool_name = fn.name if fn.name is defined else tool_call.name %}
+                {%- set call_id = tool_call.id if tool_call.id is defined else (fn.id if fn.id is defined else none) %}
+                {%- if call_id and tool_name %}
+                    {%- set tool_call_registry.entries = tool_call_registry.entries + [{"id": call_id, "name": tool_name}] %}
+                {%- endif %}
+                {{- "<|start|>assistant to=" + tool_name + "<|channel|>analysis <|constrain|>xml<|message|>" }}
+                {{- render_tool_call_body(tool_call) }}
+                {%- if loop.last %}
+                    {{- "<|call|>" }}
+                {%- else %}
+                    {{- "<|end|>" }}
+                {%- endif %}
+            {%- endfor %}
+        {%- else %}
+            {{- "<|start|>assistant<|channel|>final<|message|>" + (message.content or "") + "<|return|>" }}
+        {%- endif %}
+        {%- endgeneration %}
+    {%- elif message.role == 'tool' -%}
+        {%- set resolved_tool = namespace(name=none) %}
+        {%- if message.name is defined and message.name %}
+            {%- set resolved_tool.name = message.name %}
+        {%- elif message.tool_call_id is defined %}
+            {%- for entry in tool_call_registry.entries %}
+                {%- if entry.id == message.tool_call_id %}
+                    {%- set resolved_tool.name = entry.name %}
+                {%- endif %}
+            {%- endfor %}
+        {%- endif %}
+        {%- if resolved_tool.name is none %}
+            {{- raise_exception("Tool message needs 'name' or a matching prior tool_call 'id' / 'tool_call_id'.") }}
+        {%- endif %}
+        {{- "<|start|>" + resolved_tool.name + " to=assistant<|channel|>analysis<|message|>" + (message.content or "") + "<|end|>" }}
+    {%- elif message.role == 'user' -%}
+        {{- "<|start|>user<|message|>" + (message.content or "") + "<|end|>" }}
+    {%- endif -%}
+{%- endfor -%}
+
+{%- if add_generation_prompt -%}
+<|start|>assistant
+{%- endif -%}
diff --git a/tools/mm3/beam_setup.py b/tools/mm3/beam_setup.py
new file mode 100644
index 0000000..3112236
--- /dev/null
+++ b/tools/mm3/beam_setup.py
@@ -0,0 +1,88 @@
+"""tools/mm3/beam_setup.py - Reflection Beam-1.0 on maya-mm3 without the installer's model list: the pack beside a Beam
+GGUF set (pack_beam_gguf.py, once) and the server's config, maya-beam.json in the Maya folder.
+
+    python tools/mm3/beam_setup.py --model ~/models/Beam-1.0-501B-A23B-GGUF/UD-Q2_K_XL --context 262144
+    .venv/bin/python serve/server.py --engine maya --config maya-beam.json
+
+The engine is build/maya-mm3 (cmake --build build --target maya-mm3); Beam runs on its layer split (no --tp, no
+--parallel, no DSpark draft, text only).  Its K / V: the 9 global layers' every position (36 KiB a token in BF16, half
+in INT8 - the default), the 43 sliding layers' last 512 in a ring.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import pathlib
+import sys
+import time
+
+HERE = pathlib.Path(__file__).resolve().parent
+ROOT = HERE.parent.parent
+_spec = importlib.util.spec_from_file_location("pack_beam_gguf", HERE / "pack_beam_gguf.py")
+_pack = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_pack)
+
+MODEL_NAME = "Beam-1.0-501B-A23B"
+SAMPLING = {"temperature": 0.7, "top_p": 0.99}   # (generation_config.json's)
+
+
+def quant_name(pack: pathlib.Path) -> str:
+    """The pack's quant_name (the GGUF's general.name), for the server's label."""
+    for line in (pack / "mm3.txt").read_text(encoding="utf-8").splitlines():
+        if line.startswith("quant_name "):
+            return line.split(" ", 1)[1].strip()
+    return ""
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True, help="the folder of the Beam GGUF's shards")
+    ap.add_argument("--context", type=int, default=131072, help="positions (Beam reads up to 1048576)")
+    ap.add_argument("--kv-cache", default="int8", choices=["bf16", "int8", "fp8"], help="the K / V cache's format")
+    ap.add_argument("--gpus", help="e.g. 0,1 (default: every GPU)")
+    ap.add_argument("--chunk", type=int, help="prompt tokens a forward (the engine's default 1024)")
+    ap.add_argument("--repack", action="store_true", help="build the pack again")
+    ap.add_argument("--no-group-limit", action="store_true", help="llama.cpp's routing (every expert a candidate)")
+    ap.add_argument("--port", type=int, default=8080)
+    ap.add_argument("--host", help="where the server listens (default: the server's, 127.0.0.1)")
+    ap.add_argument("--api-key", help="the key clients send (MAYA_API_KEY works as well)")
+    ap.add_argument("--reasoning-effort", choices=["minimal", "low", "medium", "high", "xhigh", "max"],
+                    help="the default thinking level (none: the template's, max)")
+    ap.add_argument("--config", default=str(ROOT / "maya-beam.json"))
+    a = ap.parse_args()
+    model = pathlib.Path(a.model).expanduser().resolve()
+    pack = model / "maya-mm3"
+    if a.repack or not (pack / "mm3.txt").is_file() or "model_type beam" not in (pack / "mm3.txt").read_text():
+        _pack.pack(model, pack, None, not a.no_group_limit)
+    else:
+        print("pack: %s (kept; --repack builds it again)" % pack)
+    exe = ROOT / "build" / ("maya-mm3.exe" if sys.platform == "win32" else "maya-mm3")
+    if not exe.is_file():
+        print("note: %s is not built yet - cmake --build build --target maya-mm3" % exe)
+    args = ["--pack", str(pack), "--max-context", str(a.context), "--kv-cache", a.kv_cache, "--vision", "off"]
+    if a.gpus:
+        args += ["--gpus", a.gpus]
+    if a.chunk:
+        args += ["--chunk", str(a.chunk)]
+    cfg_path = pathlib.Path(a.config).expanduser()
+    cfg = {"exe": str(exe), "args": args, "cwd": str(ROOT), "tokenizer": str(pack / "tokenizer"),
+           "model_name": MODEL_NAME, "sampling": dict(SAMPLING), "port": a.port,
+           "log": str(cfg_path.with_suffix(".log")),
+           "installer": {"family": "minimax", "quant": MODEL_NAME, "model_dir": str(model), "beam": True,
+                         "quant_name": quant_name(pack),
+                         "written": time.strftime("%Y-%m-%d %H:%M")}}
+    if a.reasoning_effort:
+        cfg["reasoning_effort"] = a.reasoning_effort
+    if a.host:
+        cfg["host"] = a.host
+    if a.api_key:
+        cfg["api_key"] = a.api_key
+    cfg_path.write_text(json.dumps(cfg, indent=1), encoding="utf-8")
+    print("config: %s" % cfg_path)
+    print("start:  %s serve/server.py --engine maya --config %s" % (ROOT / ".venv" / "bin" / "python", cfg_path))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/mm3/pack_beam_gguf.py b/tools/mm3/pack_beam_gguf.py
new file mode 100644
index 0000000..d2e0278
--- /dev/null
+++ b/tools/mm3/pack_beam_gguf.py
@@ -0,0 +1,310 @@
+"""tools/mm3/pack_beam_gguf.py - maya-mm3's pack for a Reflection Beam-1.0-501B-A23B GGUF set (llama.cpp's `beam`
+layout: unsloth's, bartowski's ...), beside the model's files (no weights copied).
+
+    python tools/mm3/pack_beam_gguf.py --model ~/models/Beam-1.0-501B-A23B-GGUF/UD-Q2_K_XL
+
+writes <model>/maya-mm3/ in pack_gguf.py's format, so maya-mm3 reads it:
+  mm3.txt       model_type beam and Beam's geometry under config.json's names (from the GGUF's beam.* keys): the
+                layers' sliding pattern (sliding_layers), the window, the NoPE query scale, the logit softcap, the expert
+                groups; format gguf, quant_name, model_dir
+  tensors.txt   every tensor under the names the engine reads (pack_gguf.py's, MiniMax's where the role is the same):
+                the routed experts an entry each (layers.N.block_sparse_moe.experts.E.w1 / w3 / w2.weight); Beam's own
+                as self_attn.gate_proj.weight / self_attn.gate_bias (the attention gate), self_attn.post_norm.weight and
+                mlp_post_norm.weight (the sandwich norms after the attention and after the MLP);
+                post_attention_layernorm.weight is the MLP's input norm (llama.cpp's ffn_norm), as MiniMax's
+  tokenizer/    the server's tokenizer from the GGUF's vocabulary (pre "qwen2", NFC - Beam's tokenizer.json), its
+                special ids (eos <|return|>, eos2 <|call|>), and Beam's chat template (the GGUF's own, else this
+                directory's beam_chat_template.jinja - Reflection's, Apache-2.0)
+
+The expert groups: Beam routes within the 4 best of 8 groups of 32 experts (config.json's n_group / topk_group, as
+transformers' and SGLang's BeamTopkRouter).  llama.cpp's converter writes no group keys, so its `beam` graph routes over
+all 256: --no-group-limit packs that (for comparing logits with llama.cpp on the same GGUF); the default is Beam's.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import os
+import pathlib
+import re
+import sys
+
+HERE = pathlib.Path(__file__).resolve().parent
+TEMPLATE = HERE / "beam_chat_template.jinja"
+
+_spec = importlib.util.spec_from_file_location("ds4_pack_gguf", HERE.parent / "ds4" / "pack_gguf.py")
+_ds4 = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_ds4)
+Gguf, TYPES = _ds4.Gguf, _ds4.TYPES   # (maya-ds4's GGUF reader: the shards' metadata and tensor infos)
+
+ARCH = "beam"
+P = "language_model.model."
+# GGUF name (blk.N. stripped) -> the engine's under layers.N.
+LAYER = {
+    "attn_norm.weight": "input_layernorm.weight",
+    "post_attention_norm.weight": "self_attn.post_norm.weight",
+    "ffn_norm.weight": "post_attention_layernorm.weight",          # (the MLP's input norm: the engine's post1)
+    "post_ffw_norm.weight": "mlp_post_norm.weight",
+    "attn_q.weight": "self_attn.q_proj.weight",
+    "attn_k.weight": "self_attn.k_proj.weight",
+    "attn_v.weight": "self_attn.v_proj.weight",
+    "attn_output.weight": "self_attn.o_proj.weight",
+    "attn_q_norm.weight": "self_attn.q_norm.weight",
+    "attn_k_norm.weight": "self_attn.k_norm.weight",
+    "attn_gate.weight": "self_attn.gate_proj.weight",
+    "attn_gate.bias": "self_attn.gate_bias",
+    "ffn_gate_inp.weight": "block_sparse_moe.gate.weight",
+    "exp_probs_b.bias": "block_sparse_moe.e_score_correction_bias",
+    "ffn_gate_exps.weight": "block_sparse_moe.experts.w1",          # [n_exp][ff][dim]: an entry an expert
+    "ffn_up_exps.weight": "block_sparse_moe.experts.w3",
+    "ffn_down_exps.weight": "block_sparse_moe.experts.w2",          # [n_exp][dim][ff]
+    "ffn_gate.weight": "mlp.gate_proj.weight",                      # (the leading dense layers)
+    "ffn_up.weight": "mlp.up_proj.weight",
+    "ffn_down.weight": "mlp.down_proj.weight",
+}
+GLOBAL = {"token_embd.weight": P + "embed_tokens.weight", "output_norm.weight": P + "norm.weight",
+          "output.weight": "language_model.lm_head.weight"}
+EVERY = ("attn_norm.weight", "post_attention_norm.weight", "ffn_norm.weight", "post_ffw_norm.weight", "attn_q.weight",
+         "attn_k.weight", "attn_v.weight", "attn_output.weight", "attn_q_norm.weight", "attn_k_norm.weight",
+         "attn_gate.weight", "attn_gate.bias")
+DENSE = ("ffn_gate.weight", "ffn_up.weight", "ffn_down.weight")
+MOE = ("ffn_gate_inp.weight", "exp_probs_b.bias", "ffn_gate_exps.weight", "ffn_up_exps.weight", "ffn_down_exps.weight")
+# the matrices the engine's GGUF kernels take as they are stored (ds4_iq's mv types; the experts: its expert types)
+MATRIX_TYPES = {"Q2_K", "Q3_K", "Q4_K", "Q5_K", "Q6_K", "Q8_0", "IQ1_S", "IQ1_M", "IQ2_XXS", "IQ2_XS", "IQ2_S",
+                "IQ3_XXS", "IQ3_S", "IQ4_XS", "IQ4_NL"}
+EXPERT_TYPES = MATRIX_TYPES - {"Q6_K", "Q8_0"}
+BEAM_GROUPS = (8, 4)   # config.json's n_group, topk_group
+NOPE = (0.1, 2048.0)   # transformers' compute_attention_scaling (llama.cpp's defaults where the GGUF has no key)
+
+
+def geometry(kv: dict, vocab: int, group_limit: bool) -> dict:
+    """config.json's names (what the engine's Geo::read_beam reads) from the GGUF's beam.* keys."""
+    g = lambda k, d=None: kv.get("%s.%s" % (ARCH, k), d)  # noqa: E731
+    nl, lead = int(g("block_count")), int(g("leading_dense_block_count", 0))
+    pattern = g("attention.sliding_window_pattern")
+    if not isinstance(pattern, list) or len(pattern) != nl:
+        raise SystemExit("the GGUF has no beam.attention.sliding_window_pattern of %d layers" % nl)
+    heads = g("attention.head_count")
+    kvh = g("attention.head_count_kv")
+    if isinstance(heads, list) or isinstance(kvh, list):
+        if len(set(heads if isinstance(heads, list) else [heads])) != 1 or \
+                len(set(kvh if isinstance(kvh, list) else [kvh])) != 1:
+            raise SystemExit("per-layer head counts that differ: not Beam's geometry")
+        heads = heads[0] if isinstance(heads, list) else heads
+        kvh = kvh[0] if isinstance(kvh, list) else kvh
+    ng, tg = (int(g("expert_group_count", BEAM_GROUPS[0])), int(g("expert_group_used_count", BEAM_GROUPS[1]))) \
+        if group_limit else (1, 1)
+    return {
+        "model_type": "beam",
+        "hidden_size": g("embedding_length"),
+        "num_hidden_layers": nl,
+        "num_attention_heads": heads,
+        "num_key_value_heads": kvh,
+        "head_dim": g("attention.key_length"),
+        "vocab_size": vocab,
+        "num_local_experts": g("expert_count"),
+        "num_experts_per_tok": g("expert_used_count"),
+        "intermediate_size": g("expert_feed_forward_length"),
+        "dense_intermediate_size": g("feed_forward_length"),
+        "rope_theta": g("rope.freq_base_swa", g("rope.freq_base", 10000.0)),
+        "rms_norm_eps": g("attention.layer_norm_rms_epsilon"),
+        "routed_scaling_factor": g("expert_weights_scale", 1.0),
+        "max_position_embeddings": g("context_length"),
+        "moe_layer_freq": [0] * lead + [1] * (nl - lead),
+        "sliding_layers": [1 if p else 0 for p in pattern],
+        "sliding_window": g("attention.sliding_window"),
+        "n_group": ng,
+        "topk_group": tg,
+        "final_logit_softcapping": g("final_logit_softcapping", 0.0),
+        "nope_scale_power": g("attention.temperature_scale", NOPE[0]),
+        "nope_scale_length": g("attention.temperature_length", NOPE[1]),
+    }
+
+
+def write_tokenizer(out: pathlib.Path, kv: dict) -> dict:
+    """pack_gguf.py's layout from the GGUF's vocabulary (pre qwen2), Beam's special ids, its chat template."""
+    tokens = kv["tokenizer.ggml.tokens"]
+    types = kv.get("tokenizer.ggml.token_type") or [1] * len(tokens)
+    merges = kv.get("tokenizer.ggml.merges") or []
+    if len(set(tokens)) != len(tokens):
+        raise SystemExit("the GGUF's vocabulary has duplicate token strings")
+    if kv.get("tokenizer.ggml.model") != "gpt2":
+        raise SystemExit("the GGUF's tokenizer is not byte-level BPE (tokenizer.ggml.model %r)" %
+                         kv.get("tokenizer.ggml.model"))
+    pre = kv.get("tokenizer.ggml.pre")
+    if pre not in (None, "qwen2"):
+        print("note: the GGUF names its pre-tokenizer %r - the pack transcribes Beam's (qwen2)" % pre)
+    ids = {t: i for i, t in enumerate(tokens)}
+    for t in ("<|return|>", "<|call|>", "<|start|>", "<|end|>", "<|message|>", "<|channel|>"):
+        if t not in ids:
+            raise SystemExit("the GGUF's vocabulary has no %s: not Beam's" % t)
+    special = {"eos": ids["<|return|>"], "eos2": ids["<|call|>"]}
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "vocab.json").write_text(json.dumps(ids, ensure_ascii=False), encoding="utf-8")
+    (out / "merges.txt").write_text("\n".join(merges), encoding="utf-8")
+    (out / "token_type.json").write_text(json.dumps([int(t) for t in types]))
+    (out / "tokenizer.json").write_text(json.dumps({"pre": "qwen2", "special_ids": special}, indent=1))
+    own = kv.get("tokenizer.chat_template")
+    tpl = own if isinstance(own, str) and '<rfl:parameter name="' in own else TEMPLATE.read_text(encoding="utf-8")
+    (out / "chat_template.jinja").write_text(tpl, encoding="utf-8")
+    return special
+
+
+def find_shards(model: pathlib.Path, names: list[str] | None) -> list[pathlib.Path]:
+    paths = [model / n for n in names] if names else sorted(model.glob("*.gguf"))
+    missing = [p for p in paths if not p.is_file()]
+    if not paths or missing:
+        raise SystemExit("%s: no .gguf files" % model if not paths else "%s: not there" % missing[0])
+    return paths
+
+
+def pack(model: pathlib.Path, out: pathlib.Path, shards: list[str] | None = None, group_limit: bool = True,
+         quiet: bool = False) -> dict:
+    paths = find_shards(model, shards)
+    gs = [Gguf(p) for p in paths]
+    kv = next((g.kv for g in gs if "general.architecture" in g.kv), None)
+    if kv is None or kv.get("general.architecture") != ARCH:
+        raise SystemExit("%s: not a Beam GGUF (architecture %r)" % (model, kv and kv.get("general.architecture")))
+    split = int(kv.get("split.count", 1))
+    if split != len(gs):
+        raise SystemExit("%s: %d of the %d shards are here" % (model, len(gs), split))
+    # (unsloth's first shard holds the metadata alone, no tensors: it ends before its data's aligned start - whole)
+    why = next((w for w in (_ds4.short(g) for g in gs if g.tensors) if w), None)
+    if why:
+        raise SystemExit("%s: not whole (%s) - a download still running?" % (model, why))
+    rel = lambda p: os.path.relpath(p, model).replace(os.sep, "/")  # noqa: E731
+    files = [rel(p) for p in paths]
+    if any(" " in f for f in files):
+        raise SystemExit("a file name with a space: %s" % [f for f in files if " " in f])
+    n_exp = int(kv["%s.expert_count" % ARCH])
+    nl = int(kv["%s.block_count" % ARCH])
+    lead = int(kv.get("%s.leading_dense_block_count" % ARCH, 0))
+    tensors, unknown, have = [], [], set()
+    for fi, g in enumerate(gs):
+        for name, typ, dims, off in g.tensors:
+            if typ not in TYPES:
+                raise SystemExit("%s: %s has ggml type %d, which the engine does not read" % (g.path.name, name, typ))
+            tname, per, bpb = TYPES[typ]
+            nel = 1
+            for d in dims:
+                nel *= d
+            if dims[0] % per:
+                raise SystemExit("%s: %s rows of %d are not whole %s blocks" % (g.path.name, name, dims[0], tname))
+            nbytes = nel // per * bpb
+            m = re.match(r"blk\.(\d+)\.(.+)$", name)
+            if m and m.group(2) in LAYER:
+                ck = "%slayers.%s.%s" % (P, m.group(1), LAYER[m.group(2)])
+                have.add((int(m.group(1)), m.group(2)))
+            elif name in GLOBAL:
+                ck = GLOBAL[name]
+                have.add((-1, name))
+            else:
+                unknown.append(name)
+                continue
+            shape = list(reversed(dims))     # ggml ne0 innermost -> torch order, outermost first
+            base = g.data_start + off
+            role = m.group(2) if m else name
+            if role.endswith("_exps.weight"):
+                if tname not in EXPERT_TYPES:
+                    raise SystemExit("%s: %s is %s - the engine's expert kernels take %s" %
+                                     (g.path.name, name, tname, ", ".join(sorted(EXPERT_TYPES))))
+                if shape[0] != n_exp:
+                    raise SystemExit("%s: %s holds %d experts, not %d" % (g.path.name, name, shape[0], n_exp))
+                part = nbytes // n_exp
+                pre, r = ck.rsplit(".", 1)
+                for i in range(n_exp):
+                    tensors.append(("%s.%d.%s.weight" % (pre, i, r), tname, fi, base + i * part, part, shape[1:]))
+                continue
+            if len(shape) == 2 and role not in ("token_embd.weight", "ffn_gate_inp.weight") and \
+                    tname not in MATRIX_TYPES:
+                raise SystemExit("%s: %s is %s - the engine's GGUF matrices are block types (%s)" %
+                                 (g.path.name, name, tname, ", ".join(sorted(MATRIX_TYPES))))
+            tensors.append((ck, tname, fi, base, nbytes, shape))
+    if unknown:
+        raise SystemExit("tensors the pack does not map (%d): %s" % (len(unknown), ", ".join(unknown[:12])))
+    lacking = []
+    for li in range(nl):
+        for n in EVERY + (DENSE if li < lead else MOE):
+            if (li, n) not in have:
+                lacking.append("blk.%d.%s" % (li, n))
+    for n in GLOBAL:
+        if (-1, n) not in have and n != "output.weight":
+            lacking.append(n)
+    if (-1, "output.weight") not in have:
+        lacking.append("output.weight (a tied head is not covered)")
+    if lacking:
+        raise SystemExit("the set lacks %d tensors: %s" % (len(lacking), ", ".join(lacking[:8])))
+    gate_up = {}
+    for t in tensors:   # (the engine's plain SwiGLU kernels: a layer's gate and up of one type)
+        mm = re.search(r"layers\.(\d+)\.block_sparse_moe\.experts\.0\.(w1|w3)\.weight$", t[0])
+        if mm:
+            gate_up.setdefault(int(mm.group(1)), {})[mm.group(2)] = t[1]
+    two = [li for li, d in sorted(gate_up.items()) if d.get("w1") != d.get("w3")]
+    if two:
+        raise SystemExit("layer%s %s: the experts' gate and up are of two types (%s / %s) - not covered" % (
+            "s" if len(two) > 1 else "", ", ".join(map(str, two[:6])), gate_up[two[0]].get("w1"),
+            gate_up[two[0]].get("w3")))
+    embd = next(t for t in tensors if t[0] == GLOBAL["token_embd.weight"])
+    geo = geometry(kv, embd[5][0], group_limit)
+
+    out.mkdir(parents=True, exist_ok=True)
+    special = write_tokenizer(out / "tokenizer", kv)
+    dense = sorted({t[1] for t in tensors if ".experts." not in t[0] and t[1] != "F32"})
+    exp_types = {}
+    for t in tensors:
+        if ".experts.0." in t[0]:
+            exp_types[t[1]] = exp_types.get(t[1], 0) + 1
+    with (out / "mm3.txt").open("w", newline="\n") as f:
+        for k, v in geo.items():
+            if v is None:
+                continue
+            if isinstance(v, bool):
+                v = int(v)
+            f.write("%s %s\n" % (k, ",".join(str(x) for x in v) if isinstance(v, list) else v))
+        f.write("bos_token_id -1\n")
+        f.write("eos_token_id %d\n" % special["eos"])
+        f.write("eos2_token_id %d\n" % special["eos2"])
+        for k, v in special.items():
+            f.write("special.%s %d\n" % (k, v))
+        f.write("format gguf\n")
+        f.write("quant_name %s\n" % str(kv.get("general.name", model.name)).replace(" ", "-"))
+        f.write("gguf.dense %s\n" % ",".join(dense))
+        f.write("gguf.experts %s\n" % ",".join("%sx%d" % (k, v) for k, v in sorted(exp_types.items())))
+        f.write("model_dir %s\n" % model)
+    with (out / "tensors.txt").open("w", newline="\n") as f:
+        for i, name in enumerate(files):
+            f.write("file %d %s\n" % (i, name))
+        for name, dt, fi, off, nb, shape in tensors:
+            f.write("t %s %s %d %d %d %s\n" % (name, dt, fi, off, nb, " ".join(map(str, shape))))
+    if not quiet:
+        by = {}
+        for t in tensors:
+            by[t[1]] = by.get(t[1], 0) + t[4]
+        nswa = sum(geo["sliding_layers"])
+        print("%s: %d tensors in %d files (%s) -> %s" % (
+            model.name, len(tensors), len(files), ", ".join("%s %.1f GB" % (k, v / 1e9) for k, v in sorted(by.items())),
+            out))
+        print("  layers: %d (%d dense, %d MoE; %d global, %d sliding at %s); experts %s, groups %d/%d" % (
+            nl, lead, nl - lead, nl - nswa, nswa, geo["sliding_window"],
+            ", ".join("%s %d" % (k, v) for k, v in sorted(exp_types.items())), geo["n_group"], geo["topk_group"]))
+        print("  special ids: %s" % special)
+    return geo
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True, help="the directory of the GGUF's shards")
+    ap.add_argument("--out", help="default: <model>/maya-mm3")
+    ap.add_argument("--shards", nargs="+", help="the set's files in --model (default: every .gguf there)")
+    ap.add_argument("--no-group-limit", action="store_true",
+                    help="route over every expert (llama.cpp's beam graph) instead of Beam's 4 of 8 groups")
+    a = ap.parse_args()
+    model = pathlib.Path(a.model).expanduser().resolve()
+    out = pathlib.Path(a.out).expanduser() if a.out else model / "maya-mm3"
+    pack(model, out, a.shards, not a.no_group_limit)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/strata_tokenizer.py b/tools/strata_tokenizer.py
index 53138e8..574f57a 100644
--- a/tools/strata_tokenizer.py
+++ b/tools/strata_tokenizer.py
@@ -63,6 +63,19 @@ QWEN35_PATTERN = (
     r"|\s+"
 )
 
+# The `qwen2` pre-tokenizer (Reflection Beam-1.0's tokenizer.json - Qwen2's, llama.cpp's LLAMA_VOCAB_PRE_TYPE_QWEN2):
+# qwen35's without \p{M} - a combining mark is not a letter (it joins the punctuation run after it), as glm4's - and
+# with a single digit a piece, as qwen35's.
+QWEN2_PATTERN = (
+    r"(?i:'s|'t|'re|'ve|'m|'ll|'d)"
+    r"|[^\r\n\p{L}\p{N}]?\p{L}+"
+    r"|\p{N}"
+    r"| ?[^\s\p{L}\p{N}]+[\r\n]*"
+    r"|\s*[\r\n]+"
+    r"|\s+(?!\S)"
+    r"|\s+"
+)
+
 # The `glm4`/`glm5` pre-tokenizer, transcribed from llama-vocab.cpp L406-410 at the vendored pin
 # (LLAMA_VOCAB_PRE_TYPE_CHATGLM4).  Two differences from qwen35, both load-bearing:
 #   * the digit run is `\p{N}{1,3}` - a 4-digit number splits 3+1, not as one whole run;
@@ -141,9 +154,9 @@ class Tokenizer:
         self.pre = pre
         # Each supported scheme names a transcription of the vendored llama.cpp reference; an
         # unknown scheme is REFUSED rather than silently tokenized with the wrong splits.
-        if pre not in ("qwen35", "glm4", "glm5", "deepseek3", "minimax"):
-            raise ValueError("the %r pre-tokenizer is not transcribed; known: qwen35, glm4, glm5, deepseek3, minimax"
-                             % pre)
+        if pre not in ("qwen35", "qwen2", "glm4", "glm5", "deepseek3", "minimax"):
+            raise ValueError("the %r pre-tokenizer is not transcribed; known: qwen35, qwen2, glm4, glm5, deepseek3, "
+                             "minimax" % pre)
         # glm4/glm5 set ignore_merges: an exact vocab hit emits the whole pre-token piece
         self.ignore_merges = pre in ("glm4", "glm5")
         self.token_types = token_types
@@ -165,8 +178,9 @@ class Tokenizer:
             self.ranks[(parts[0], parts[1])] = i
         self._re = (_IsolatedSplits(DEEPSEEK3_PATTERNS) if pre == "deepseek3" else
                     regex.compile(MINIMAX_PATTERN) if pre == "minimax" else
+                    regex.compile(QWEN2_PATTERN) if pre == "qwen2" else
                     regex.compile(GLM_PATTERN if self.ignore_merges else QWEN35_PATTERN))
-        self._nfc = pre == "minimax"
+        self._nfc = pre in ("minimax", "qwen2")   # (their tokenizer.json normalizer: NFC)
 
         # The literals matched directly instead of being run through BPE.  GGUF token types: 3 = CONTROL,
         # 4 = USER_DEFINED.  The two classes behave DIFFERENTLY and llama.cpp's own tokenizer settled which:
-- 
2.39.5

