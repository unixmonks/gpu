# Copy to .env and fill in from the provider's "connect via SSH" line.
GPU_HOST=root@1.2.3.4
GPU_SSH_PORT=22
# Where models go on the box: put it on the NVMe. Empty = /workspace/gpu-data if present, else ~/gpu-data.
GPU_DATA_DIR=
# Local end of the tunnel (OpenCode talks to http://127.0.0.1:$GPU_LOCAL_PORT/v1).
GPU_LOCAL_PORT=18080
# Only for gated Hugging Face repos.
HF_TOKEN=
